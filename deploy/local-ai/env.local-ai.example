# ─────────────────────────────────────────────────────────────────────────
# 本地化那几行 —— 覆盖进 F:\eidolon-sc\.env
#
# 先起服务（一个 llama-server 端口，三模型同进程，不需要 shim）：
#   powershell -ExecutionPolicy Bypass -File deploy\local-ai\start-llama-server.ps1
# 再改 .env，重启 eidolon，然后 `cd backend; uv run eidolon doctor`
# 看 embedding / rerank / judge 三项。
#
# 这些键是「覆盖」原来的云端配置，不是新增一套：把下面几行贴进去，同名的旧行删掉，
# 文件里同一个键写两次时后出现的生效，容易自己坑自己。
#
# 唯一省不掉的线上 key 是对话模型 CHAT_LLM_API_KEY（DeepSeek）。本机用
# EIDOLON_DEV_LOGIN=1 免 OAuth。语音 TTS / STT 仍上云，见 README「边界」。
# ─────────────────────────────────────────────────────────────────────────

# ── 向量化 + 重排：零改码，服务已跑在 8094 ─────────────────────────────
# 这两项共用同一个 BASE_URL（embedding.py 拼 /embeddings，rerank.py 拼 /rerank）。
# ⚠️ SILICONFLOW_API_KEY 必须非空 —— 空字符串会让 RerankSettings.from_env() 返回 None，
#    整个重排功能静默关掉（config.py RerankSettings.from_env）。
SILICONFLOW_BASE_URL=http://127.0.0.1:8094/v1
SILICONFLOW_API_KEY=fake
# ⚠️ 这两个名字必须与 deploy/local-ai/models.ini 里的 [段名] 一模一样，
#    eidolon 把模型名原样放进请求体，llama-server 拿它当路由键。
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B

# ⚠️ 本分支已让这一行生效：重排默认只有 3 秒（retry.TURN_TIMEOUT），
#    但本机跑 36 条剧情长度的候选在 RX 6750 XT 上要 4~5 秒，会超时。
#    10 是稳妥值。坏值（0 / 负数 / 非数字）在启动期就报错。
RERANK_TIMEOUT=10


# ── 判断模型：方案 B，原生 LocalJudge，同一个 8094，不需要 shim ─────────
# JUDGE_PROVIDER=local 是本分支新增：judge.py 直接打 OpenAI 兼容
# /chat/completions（temperature:0 + strict JSON Schema），不再走 System One 协议。
JUDGE_PROVIDER=local
LOCAL_JUDGE_BASE_URL=http://127.0.0.1:8094/v1
LOCAL_JUDGE_MODEL=local-judge
# LOCAL_JUDGE_API_KEY 可留空（本地免 key）；要填也行，会当 Bearer token 发出去。
# LOCAL_JUDGE_API_KEY=

# ⚠️ 本分支已让这一行生效：JUDGE_TIMEOUT 原来在 judge.py 硬编码 5 秒，
#    本地 4B 冷启动 3.56 s、长上文会更慢，会超时。30 是稳妥值。
#    坏值（0 / 负数 / 非数字）在 Settings.from_env() 启动期就报错。
JUDGE_TIMEOUT=30


# ── 这几个保持云端不动 ────────────────────────────────────────────────
# 对话模型（DeepSeek）—— 这是唯一保留上云的服务
#   CHAT_LLM_PROTOCOL=openai
#   CHAT_LLM_BASE_URL=https://api.deepseek.com/v1
#   CHAT_LLM_API_KEY=sk-...
#   CHAT_LLM_MODEL=deepseek-chat
#   BACKGROUND_LLM_* 同理（记忆抽取等后台活，可以也用 DeepSeek）
#
# 语音合成 / 语音识别：目前**无法**本地化
#   TTS 地址硬编码三处（call.py、greetings.py、pipecat fish/tts.py）
#   STT_PROVIDER 只有 soniox / bailian 两个值
#   详见 deploy/local-ai/README.md「边界」与 notes/04-本地化调研.md 第 5 节
#
# 生图：本来就能接本地兼容服务（NOVELAI_API_FORMAT=openai + NOVELAI_BASE_URL），
#       不是这次改动的重点，见 docs/configuration.md。
